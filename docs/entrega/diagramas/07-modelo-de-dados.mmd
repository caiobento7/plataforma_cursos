  COURSES ||--o{ ENROLLMENTS : "recebe"
  COURSES ||--o{ COURSE_MODULES : "tem"
  COURSE_MODULES ||--o{ LESSONS : "tem"
  LESSONS ||--o| QUIZZES : "pode ser"
  QUIZZES ||--o{ QUIZ_QUESTIONS : "tem"
  PROFILES ||--o{ LESSON_PROGRESS : "registra"
  LESSONS ||--o{ LESSON_PROGRESS : "concluída em"
  LESSONS ||--o{ LESSON_QUESTIONS : "recebe"
  PROFILES ||--o{ LESSON_QUESTIONS : "pergunta"
